# Configuración local. Copiar como .env y completar sin usar datos personales reales.
SA_PASSWORD=

# Contraseña de las cuentas semilla de desarrollo (admin@icarus.test,
# soporte@icarus.test, cliente@icarus.test, trabajador@icarus.test). Sin datos
# personales reales.
ICARUS_SEMILLA_PASSWORD=

# API key de Seq (opcional en desarrollo: el Seq local no exige autenticación).
# La VPS central es otra historia: cada aplicación consume su propia API key
# (ver docs/operacion/observabilidad.md y docker-compose.seq.yml).
SEQ_API_KEY=

# Bootstrap productivo de cuentas globales (Migraciones:EjecutarAlArranque=true).
# Con los cuatro valores completos crea el administrador y las dos cuentas de
# CAISY (grh@icarus.online y gpa@icarus.online); si falta cualquiera no crea
# ninguna. Nunca versionar valores reales ni registrarlos en logs. Ver
# docs/operacion/bootstrap-cuentas-produccion.md.
SeedSettings__AdminEmail=
SeedSettings__AdminPassword=
SeedSettings__GestorRecepcionHuevosPassword=
SeedSettings__GestorPedidoAlimentoPassword=
