@model FormularioEntregaVista
@{
    ViewData["Titulo"] = "Aceptar pedido";
    ViewData["Seccion"] = "pedidos";
}
<div class="pagina-cabecera">
    <div>
        <h1>Aceptar pedido</h1>
        <p class="pagina-cabecera__detalle">
            La aceptación fija la entrega estimada, que se puede cambiar mientras
            el pedido esté aceptado. Debe ser hoy o posterior.
        </p>
    </div>
</div>
<partial name="_Avisos" />
<section class="tarjeta">
    <form asp-action="Aceptar" asp-route-id="@Model.Id" method="post">
        <div class="campos">
            <div class="campo">
                <label for="FechaEntregaEstimada">Fecha de entrega estimada</label>
                <input id="FechaEntregaEstimada" name="FechaEntregaEstimada" type="date"
                       value="@Model.FechaEntregaEstimada.ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="FechaEntregaEstimada" class="campo__ayuda"></span>
            </div>
        </div>
        <div class="acciones">
            <button type="submit" class="boton boton--primario"
                    data-confirmar="El pedido pasará al estado Aceptado con la entrega estimada indicada. ¿Confirma la aceptación?">
                Confirmar aceptación
            </button>
            <a class="enlace" asp-action="Detalles" asp-route-id="@Model.Id">Cancelar</a>
        </div>
    </form>
</section>
