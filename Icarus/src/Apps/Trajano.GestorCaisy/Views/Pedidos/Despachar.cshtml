@model FormularioDespachoVista
@{
    ViewData["Titulo"] = "Registrar despacho";
    ViewData["Seccion"] = "pedidos";
}
<div class="pagina-cabecera">
    <div>
        <h1>Registrar despacho</h1>
        <p class="pagina-cabecera__detalle">
            Se registra una única entrega con una única nota por pedido. Los datos
            de la nota son manuales; las diferencias contra lo solicitado son
            válidas y el tenant las verá al recibir. Las imágenes son respaldos
            privados del documento en papel (páginas o reverso).
        </p>
    </div>
</div>
<partial name="_Avisos" />
<section class="tarjeta">
    <form asp-action="Despachar" asp-route-id="@Model.Id" method="post"
          enctype="multipart/form-data">
        <div class="campos">
            <div class="campo">
                <label for="NumeroNota">Número de nota</label>
                <input id="NumeroNota" name="NumeroNota" type="text" maxlength="100"
                       value="@Model.NumeroNota" required />
                <span asp-validation-for="NumeroNota" class="campo__ayuda"></span>
            </div>
            <div class="campo">
                <label for="FechaNota">Fecha de la nota</label>
                <input id="FechaNota" name="FechaNota" type="date"
                       value="@Model.FechaNota.ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="FechaNota" class="campo__ayuda"></span>
            </div>
            <div class="campo">
                <label for="TotalInformado">Total neto informado (opcional)</label>
                <input id="TotalInformado" name="TotalInformado" type="number" step="0.01" min="0"
                       value="@(Model.TotalInformado?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                <span class="campo__ayuda">
                    El total impreso en la nota, solo para contraste: el gasto se
                    calcula con lo realmente entregado y los precios congelados.
                </span>
            </div>
        </div>
        <h2>Cantidades entregadas</h2>
        <table class="tabla">
            <thead>
                <tr>
                    <th scope="col">Tipo de alimento</th>
                    <th scope="col">Solicitado</th>
                    <th scope="col">Entregado</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lineas.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Lineas[i].TipoAlimento
                            <input type="hidden" name="Lineas[@i].TipoAlimento" value="@Model.Lineas[i].TipoAlimento" />
                            <input type="hidden" name="Lineas[@i].CantidadSolicitada" value="@Model.Lineas[i].CantidadSolicitada" />
                        </td>
                        <td>@Model.Lineas[i].CantidadSolicitada</td>
                        <td>
                            <input type="number" name="Lineas[@i].CantidadEntregada" min="0" step="1"
                                   value="@Model.Lineas[i].CantidadEntregada" required />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="campo">
            <label for="Archivos">Imágenes de respaldo (páginas o reverso)</label>
            <input id="Archivos" name="Archivos" type="file" accept="image/jpeg,image/png,image/webp" multiple />
            <span class="campo__ayuda">
                Hasta 8 imágenes de 5 MB por nota. Se guardan privadas: la
                interfaz muestra una copia segura sin metadatos.
            </span>
        </div>
        <div class="acciones">
            <button type="submit" class="boton boton--primario"
                    data-confirmar="Se registrará la entrega con su nota y pasará al estado Despachado. El tenant será notificado. ¿Confirma el despacho?">
                Registrar despacho
            </button>
            <a class="enlace" asp-action="Detalles" asp-route-id="@Model.Id">Cancelar</a>
        </div>
    </form>
</section>
