@model BandejaDespachosHuevoVista
@{
    ViewData["Titulo"] = "Recepción de huevo";
    ViewData["Seccion"] = "recepciones-huevo";
    var pagina = Model.Pagina;
    var totalPaginas = Math.Max(1, (int)Math.Ceiling(pagina.Total / (double)Model.TamanoPagina));
}
<div class="pagina-cabecera">
    <div>
        <h1>Recepción de huevo</h1>
        <p class="pagina-cabecera__detalle">
            Bandeja global de despachos de huevo despachados por los tenants.
            Confirma la recepción del que llegó y descarga su recibo; el precio
            del productor es el congelado al despacho.
        </p>
    </div>
    <a class="boton boton--neutro" asp-controller="PreciosHuevo" asp-action="Index">Precios de huevo</a>
</div>
<partial name="_Avisos" />
<section class="tarjeta">
    <h2>Novedades para CAISY (@Model.Notificaciones.Contador sin leer)</h2>
    @if (Model.Notificaciones.Items.Count == 0)
    {
        <p class="vacio__texto">No hay notificaciones de despachos de huevo.</p>
    }
    else
    {
        <ul class="novedades">
            @foreach (var notificacion in Model.Notificaciones.Items)
            {
                <li>
                    <div>
                        <span class="chip chip--@EtiquetaChip(notificacion.Tipo)">@EtiquetaNotificacion(notificacion.Tipo)</span>
                        <span>@notificacion.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="novedades__acciones">
                        @if (notificacion.DespachoHuevoId is { } despachoId)
                        {
                            <a class="enlace" asp-action="Detalles" asp-route-id="@despachoId">Ver despacho</a>
                        }
                        @if (!notificacion.Leida)
                        {
                            <form asp-action="MarcarLeida" asp-route-id="@notificacion.Id" method="post">
                                <button type="submit" class="boton boton--neutro">Marcar como leída</button>
                            </form>
                        }
                        else
                        {
                            <span class="novedades__leida">Leída</span>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</section>
<section class="tarjeta tarjeta--tabla">
    <h2>Despachos de huevo</h2>
    <form method="get" class="campos">
        <div class="campo">
            <label for="estado">Estado</label>
            <select id="estado" name="estado">
                <option value="">Todos</option>
                @foreach (var estado in new[] { "Despachado", "Recibido" })
                {
                    <option value="@estado" selected="@(Model.Estado == estado)">@estado</option>
                }
            </select>
        </div>
        <div class="campo">
            <label for="granja">Granja</label>
            <input id="granja" name="granja" type="text" value="@Model.Granja" />
        </div>
        <div class="campo">
            <label for="desde">Desde</label>
            <input id="desde" name="desde" type="date" value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="campo">
            <label for="hasta">Hasta</label>
            <input id="hasta" name="hasta" type="date" value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="campo">
            <label for="numero">Folio</label>
            <input id="numero" name="numero" type="number" min="1" value="@Model.Numero" />
        </div>
        <div class="campo">
            <button type="submit" class="boton">Filtrar</button>
        </div>
    </form>
    @if (pagina.Items.Count == 0)
    {
        <p class="vacio__texto">No hay despachos de huevo con ese filtro.</p>
    }
    else
    {
        <table class="tabla">
            <thead>
                <tr>
                    <th scope="col">Folio</th>
                    <th scope="col">Despachado</th>
                    <th scope="col">Granja</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Amarras</th>
                    <th scope="col">Huevos</th>
                    <th scope="col">Total (Bs)</th>
                    <th scope="col"><span class="solo-lectores">Acciones</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var despacho in pagina.Items)
                {
                    <tr>
                        <td>@despacho.Folio</td>
                        <td>@(despacho.FechaDespacho?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@(despacho.GranjaNombre ?? "—")</td>
                        <td><span class="chip chip--@ClaseChipEstado(despacho.Estado)">@despacho.Estado</span></td>
                        <td>@despacho.TotalAmarras</td>
                        <td>@despacho.TotalHuevos</td>
                        <td>@(despacho.TotalBs?.ToString("0.00") ?? "—")</td>
                        <td><a class="enlace" asp-action="Detalles" asp-route-id="@despacho.Id">Ver</a></td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="pagina-cabecera__detalle">
            Página @Model.NumeroPagina de @totalPaginas con @pagina.Total despachos de huevo.
            @if (Model.NumeroPagina > 1)
            {
                <a class="enlace" asp-action="Index"
                   asp-route-estado="@Model.Estado" asp-route-granja="@Model.Granja"
                   asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))" asp-route-numero="@Model.Numero"
                   asp-route-pagina="@(Model.NumeroPagina - 1)"
                   asp-route-tamanoPagina="@Model.TamanoPagina">Anterior</a>
            }
            @if (Model.NumeroPagina < totalPaginas)
            {
                <a class="enlace" asp-action="Index"
                   asp-route-estado="@Model.Estado" asp-route-granja="@Model.Granja"
                   asp-route-desde="@(Model.Desde?.ToString("yyyy-MM-dd"))"
                   asp-route-hasta="@(Model.Hasta?.ToString("yyyy-MM-dd"))" asp-route-numero="@Model.Numero"
                   asp-route-pagina="@(Model.NumeroPagina + 1)"
                   asp-route-tamanoPagina="@Model.TamanoPagina">Siguiente</a>
            }
        </p>
    }
</section>
@functions {
    // Esta bandeja es global de CAISY (ClienteId nulo en la consulta). El
    // único tipo que se creaba con ese alcance era CreditoInsuficiente, y la
    // corrección 2026-09-14 dejó de emitirlo: no se manda ninguna alerta por
    // saldo. Las filas ya existentes en base se conservan y caen en la rama
    // por defecto. El valor 1 del enum queda reservado y no se renumera.
    private static string EtiquetaNotificacion(string tipo) => tipo;

    private static string EtiquetaChip(string tipo) => tipo switch
    {
        _ => "borrador",
    };

    private static string ClaseChipEstado(string estado) => estado switch
    {
        "Despachado" => "solicitado",
        "Recibido" => "aceptado",
        _ => "borrador",
    };
}
