<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Configuración de restauración del backend. Con CPM central (Directory.Packages.props)
       y varias fuentes en la máquina, NuGet exige mapeo de fuentes (NU1507). Este repo solo
       consume paquetes públicos: la fuente privada de la máquina no se usa aquí. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
